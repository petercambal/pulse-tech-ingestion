{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Postgres": {
    "Database": "iot_main"
  },
  "Mqtt": {
    "ClientId": "pulsetech-ingestion",
    "UseTls": false,
    "TopicFilter": "pulsetech/+/+/telemetry",
    "ReconnectDelaySeconds": 5
  },
  "TelemetryRouting": {
    "Applications": {
      "smart_pot": {
        "Schema": "smart_pot",
        "Table": "telemetry",
        "Columns": [ "soil_moisture", "light_lux", "air_temp_c" ]
      }
    }
  }
}
